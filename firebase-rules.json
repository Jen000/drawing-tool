{
  "rules": {
    ".read": false,
    ".write": false,

    "session": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === '__HOST_UID__'"
    },

    "state": {
      ".read": "auth != null && (auth.uid === '__HOST_UID__' || root.child('session/openUntil').val() > now)",
      ".write": "auth != null && auth.uid === '__HOST_UID__'",
      ".validate": "newData.hasChildren(['phase', 'round'])"
    },

    "board": {
      ".read": "auth != null && (auth.uid === '__HOST_UID__' || root.child('session/openUntil').val() > now)",
      ".write": "auth != null && auth.uid === '__HOST_UID__'",
      "$drawing": {
        ".write": "auth != null && !data.exists() && newData.exists() && root.child('session/openUntil').val() > now",
        ".validate": "newData.hasChildren(['name', 'dataUrl', 'ts', 'round'])",
        "name":    { ".validate": "newData.isString() && newData.val().length <= 24" },
        "dataUrl": { ".validate": "newData.isString() && newData.val().length <= 400000 && newData.val().beginsWith('data:image/jpeg;base64,')" },
        "ts":      { ".validate": "newData.isNumber()" },
        "round":   { ".validate": "newData.isString() && newData.val() === root.child('state/round').val()" },
        "$other":  { ".validate": false }
      }
    },

    "votes": {
      ".read": "auth != null && (auth.uid === '__HOST_UID__' || root.child('session/openUntil').val() > now)",
      ".write": "auth != null && auth.uid === '__HOST_UID__'",
      "$voter": {
        ".write": "auth != null && $voter === auth.uid && !data.exists() && newData.exists() && root.child('session/openUntil').val() > now",
        ".validate": "newData.hasChildren(['choice', 'ts', 'round'])",
        "choice": { ".validate": "newData.isString() && root.child('board').child(newData.val()).exists()" },
        "ts":     { ".validate": "newData.isNumber()" },
        "round":  { ".validate": "newData.isString() && newData.val() === root.child('state/round').val()" },
        "$other": { ".validate": false }
      }
    }
  }
}
